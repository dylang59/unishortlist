{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ucasbuster",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",

  // Static pages (search + export UI) are served straight from assets; the
  // Worker only handles /api/*. run_worker_first keeps the API routes from
  // being shadowed by a same-named asset. The app routes by #hash, never by
  // path, so an unknown path gets a real 404 (public/404.html) rather than
  // the home page with a 200, which search engines index as a duplicate.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ucasbuster",
      "database_id": "2a9c651a-e0b7-4ae3-9eec-c9e352084663"
    }
  ],

  "observability": {
    "enabled": true
  }
}
